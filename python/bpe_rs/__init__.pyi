from typing import Dict, List, Tuple, TypeVar

Merge = Tuple[Tuple[int, int], int]
VocabList = Dict[int, List[int]]

def build_info() -> str: ...
def encode_train(s: List[str]) -> List[Merge]: ...
def encode(s: List[str], merges: List[Merge]) -> List[int]: ...
def decode_string(ids: List[int], vocab_list: VocabList) -> str: ...

_T = TypeVar("_T", bound="BPETokenizer")

class BPETokenizer:
    def __init__(self, pattern: str | None = None) -> None: ...
    def train(self, text: str | List[str]) -> None: ...
    def encode(self, text: str) -> List[int]: ...
    def decode(self, ids: List[int]) -> str: ...
    def save(self, path: str) -> None: ...
    @classmethod
    def load(cls: type[_T], path: str, pattern: str | None = None) -> _T: ...
